# URL canonique du site (HTTPS). Utilisée par le sitemap.
NUXT_PUBLIC_SITE_URL=https://siana-joaillerie.fr

# Après SSL Active dans hPanel : mettre à 1 pour forcer HTTP → HTTPS (ou activer Force HTTPS dans le panneau).
NUXT_FORCE_HTTPS=

# Cloudflare Turnstile. Si l’une des deux valeurs est vide, le captcha est désactivé.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=

# Lien du bouton « Parlons de votre projet ». Vide : le bouton n’est pas un lien.
NUXT_PUBLIC_APPOINTMENT_URL=

# MySQL du quiz. Si l’hôte est vide, les soumissions sont écrites dans data/quiz-leads.jsonl.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Courrier du quiz. MAIL_TO reçoit chaque formulaire. Le second envoi part aussi vers la personne.
# Gmail : SMTP_HOST=smtp.gmail.com et port 587. Boîte Hostinger : SMTP_HOST=smtp.hostinger.com et port 465.
MAIL_TO=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
