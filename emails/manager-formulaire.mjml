<mjml lang="fr">
  <mj-head>
    <mj-title>Formulaire rempli</mj-title>
    <mj-preview>{{prenom}} {{nom}} a terminé le parcours {{parcours}}. Style {{style}}.</mj-preview>
    <mj-include path="./partials/attributes.mjml" />
  </mj-head>
  <mj-body background-color="#f5e0cb" width="600px">
    <mj-include path="./partials/header.mjml" />
    <mj-section background-color="#f5e0cb" padding="36px 32px 8px">
      <mj-column>
        <mj-text mj-class="kicker">Atelier</mj-text>
        <mj-text mj-class="title">Formulaire rempli</mj-text>
        <mj-text padding="0">{{prenom}} {{nom}} vient de remplir le formulaire {{parcours}}.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#f5e0cb" padding="16px 32px 8px">
      <mj-column background-color="#ffffff" padding="20px 22px">
        <mj-text color="#ae6868" font-size="12px" font-weight="500" letter-spacing="1px" padding="0 0 10px" text-transform="uppercase">Coordonnées</mj-text>
        <mj-text css-class="message" padding="0">{{coordonnees}}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#f5e0cb" padding="8px 32px 8px">
      <mj-column background-color="#ffffff" padding="20px 22px">
        <mj-text color="#ae6868" font-size="12px" font-weight="500" letter-spacing="1px" padding="0 0 10px" text-transform="uppercase">Réponses</mj-text>
        <mj-text css-class="message" padding="0">{{reponses}}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#f5e0cb" padding="12px 32px 28px">
      <mj-column>
        <mj-button href="mailto:{{email}}">Répondre</mj-button>
      </mj-column>
    </mj-section>
    <mj-include path="./partials/footer.mjml" />
  </mj-body>
</mjml>
